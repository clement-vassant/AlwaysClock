<?xml version="1.0" encoding="utf-8"?>
<!-- Raccourcis (appui long sur l'icône), utilisables aussi par les routines qui acceptent les raccourcis d'app. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="day"
        android:icon="@drawable/ic_clock"
        android:shortcutShortLabel="@string/day_clock">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.shodo.standbyclock"
            android:targetClass="io.shodo.standbyclock.MainActivity">
            <extra android:name="theme" android:value="day" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="night"
        android:icon="@drawable/ic_clock_night"
        android:shortcutShortLabel="@string/night_clock">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.shodo.standbyclock"
            android:targetClass="io.shodo.standbyclock.MainActivity">
            <extra android:name="theme" android:value="night" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="settings"
        android:icon="@drawable/ic_clock"
        android:shortcutShortLabel="@string/settings">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.shodo.standbyclock"
            android:targetClass="io.shodo.standbyclock.SettingsActivity" />
    </shortcut>
</shortcuts>
