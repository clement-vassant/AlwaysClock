root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 140
# Les fonctions @Composable commencent par une majuscule.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Cette règle plante sur MediaCard.kt (compose-rules 0.6.8) : désactivée en attendant un correctif.
ktlint_compose_modifier-clickable-order = disabled
